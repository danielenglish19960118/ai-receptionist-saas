{
  "name": "Garfield Enterprise AI Revenue Engine (Fully Connected)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "b58efaee-780e-4714-a783-abdfc1448cef",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "id": "node-webhook",
      "name": "⚡ Webhook Trigger"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "user_msg",
              "name": "user_message",
              "value": "={{ $json.body.message }}",
              "type": "string"
            },
            {
              "id": "session_id",
              "name": "session_id",
              "value": "={{ $json.body.sessionId || $json.headers['x-forwarded-for'] || 'default-session' }}",
              "type": "string"
            },
            {
              "id": "ai_provider",
              "name": "provider",
              "value": "={{ $json.body.provider || 'gemini' }}",
              "type": "string"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "id": "node-parse-input",
      "name": "🧹 Parse & Standardize Input"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT role, message FROM chat_history WHERE session_id = '{{ $json.session_id }}' ORDER BY created_at ASC LIMIT 10;"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 0],
      "id": "node-fetch-memory",
      "name": "🧠 Redis/Supabase Memory Fetch"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $node['🧹 Parse & Standardize Input'].json.provider }}",
        "rules": {
          "rules": [
            {
              "value2": "gemini",
              "output": 0
            },
            {
              "value2": "openai",
              "output": 1
            },
            {
              "value2": "deepseek",
              "output": 2
            }
          ]
        },
        "fallbackOutput": 0
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [660, 0],
      "id": "node-ai-switcher",
      "name": "🔀 AI Provider Switcher"
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [900, -200],
      "id": "node-gemini-ai",
      "name": "🎯 Intent Evaluator AI (Gemini Free)"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [900, 0],
      "id": "node-openai-ai",
      "name": "🎯 Intent Evaluator AI (OpenAI)"
    },
    {
      "parameters": {
        "model": "deepseek-chat",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [900, 200],
      "id": "node-deepseek-ai",
      "name": "🎯 Intent Evaluator AI (DeepSeek)"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.intent_score || 80 }}",
              "operation": "largerEqual",
              "value2": 85
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1140, 0],
      "id": "node-safety-switch",
      "name": "🛡️ Human Safety Switch (High Intent?)"
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "🚨 *VIP High-Intent Lead Alert*\n• *Session*: `{{ $node['🧹 Parse & Standardize Input'].json.session_id }}`\n• *Message*: \"{{ $node['🧹 Parse & Standardize Input'].json.user_message }}\""
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1380, -120],
      "id": "node-slack-alert",
      "name": "🔔 Slack Urgent VIP Alert"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (session_id, user_message) VALUES ('{{ $node['🧹 Parse & Standardize Input'].json.session_id }}', '{{ $node['🧹 Parse & Standardize Input'].json.user_message }}');"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1380, 120],
      "id": "node-supabase-sync",
      "name": "💾 Supabase / CRM Sync"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"provider_used\": \"{{ $node['🧹 Parse & Standardize Input'].json.provider }}\",\n  \"message\": \"Processed successfully\"\n}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1600, 0],
      "id": "node-respond-webhook",
      "name": "📤 Respond to Webhook"
    }
  ],
  "connections": {
