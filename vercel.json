{
  "version": 2,
  "rewrites": [
    {
      "source": "/telegram-webhook",
      "destination": "/api/index"
    },
    {
      "source": "/api/telegram-webhook",
      "destination": "/api/index"
    },
    {
      "source": "/whatsapp-webhook",
      "destination": "/api/index"
    },
    {
      "source": "/api/whatsapp-webhook",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
